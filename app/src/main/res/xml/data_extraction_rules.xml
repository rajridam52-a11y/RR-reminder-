<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="rr_reminder_secure_prefs.xml"/>
        <exclude
            domain="database"
            path="rr_reminder_database-wal"/>
        <exclude
            domain="database"
            path="rr_reminder_database-shm"/>
        <exclude
            domain="root"
            path="no_backup"/>
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="rr_reminder_secure_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
